{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Log Studio AI",
  "version": "../package.json",
  "identifier": "com.logstudio.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Log Studio AI",
        "width": 1440,
        "height": 900,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCODFEMDU1QTI1QzFGOEEKUldTS0gxeWlWZENCNjRsRTIzdUF2QmtwMnd2ZmN1alNFUVdXbGw2ZW5ZaEpMbVdPbk8vMS9MYi8K",
      "endpoints": [
        "https://github.com/GabrielT7878/log-studio-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
